{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Evaluate WAFT on realm_1_100m_w_tandem",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/evaluate.py",
            "python": "/opt/conda/envs/waft/bin/python",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--cfg", "config/a1/tar.json",
                "--ckpt", "weights/tar-c-t.pth",
                "--dataset", "realm",
                "--data_root", "custom/realm_1_100m_w_tandem",
                "--output_path", "outputs/realm_1_100m_w_tandem"
            ]
        },
        {
            // Pair tensors + the eager model's flow for them, the reference the
            // package is evaluated against. Non-debug equivalent of this and the
            // three configurations below: scripts/run_aot_export_chain.sh
            // --resolution here decides the image size of everything downstream: the
            // configurations below read the pairs from this snapshot, so to change it,
            // change it here and in their outputs/aoti/fp32_640x480 paths.
            "name": "Export Dataset (.pt2)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/export_dataset.py",
            "python": "/opt/conda/envs/waft/bin/python",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0"
            },
            "args": [
                "--data_root", "${workspaceFolder}/custom/realm_1_100m_w_tandem",
                "--resolution", "640x480",
                "--precision", "fp32",
                "--offset", "0",
                "--count", "3",
                "--output", "${workspaceFolder}/outputs/dataset_flow_realm_1_100m_fp32.pt2"
            ]
        },
        {
            // Optional, for inspecting the graph: aot_compile_flow.py re-exports the
            // model itself and does not consume this .pt2.
            // PYDEVD_USE_SYS_MONITORING=0 is carried over from the depthsplat export
            // configurations: legacy debugpy tracing, so that torch.export does not
            // capture fake/meta tensor constants under the Python 3.12+
            // sys.monitoring backend.
            "name": "Export Flow Model (.pt2)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/export_flow_model.py",
            "python": "/opt/conda/envs/waft/bin/python",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0",
                "PYDEVD_USE_SYS_MONITORING": "0"
            },
            "args": [
                "--dataset_pt2", "${workspaceFolder}/outputs/dataset_flow_realm_1_100m_fp32.pt2",
                "--output", "${workspaceFolder}/outputs/waft_flow.pt2"
            ]
        },
        {
            // Step 1/2: compile to a self-contained AOTInductor .pt2 package, about
            // 1.5 minutes. Writes outputs/aoti/fp32_640x480/ plus a build_info.json
            // recording the image size, the model and the torch version the package
            // is locked to.
            "name": "AOT Compile Flow",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/aot_compile_flow.py",
            "python": "/opt/conda/envs/waft/bin/python",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0",
                "PYDEVD_USE_SYS_MONITORING": "0"
            },
            "args": [
                "--dataset_pt2", "${workspaceFolder}/outputs/dataset_flow_realm_1_100m_fp32.pt2",
                "--output_dir", "${workspaceFolder}/outputs/aoti/fp32_640x480",
                "--clean"
            ]
        },
        {
            // Step 2/2: run the package, time it and diff it against the eager model.
            // Add "--precision", "tf32" (or "default") to run the same package in
            // another arithmetic mode; only fp32 is a verdict on the build.
            "name": "Run Flow Package",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_flow_aoti.py",
            "python": "/opt/conda/envs/waft/bin/python",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0"
            },
            "args": [
                "--package", "${workspaceFolder}/outputs/aoti/fp32_640x480/waft_flow.pt2",
                "--dataset_pt2", "${workspaceFolder}/outputs/dataset_flow_realm_1_100m_fp32.pt2",
                "--benchmark", "--bench_iters", "8",
                "--compare_eager",
                "--output_dir", "${workspaceFolder}/outputs/aoti_flow",
                "--clean"
            ]
        },
        {
            // Diff the package against the eager flow stored in the snapshot. Needs
            // neither the checkpoint nor the model code.
            "name": "Evaluate Flow Package",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/evaluate_flow_aoti.py",
            "python": "/opt/conda/envs/waft/bin/python",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0"
            },
            "args": [
                "--package", "${workspaceFolder}/outputs/aoti/fp32_640x480/waft_flow.pt2",
                "--dataset_pt2", "${workspaceFolder}/outputs/dataset_flow_realm_1_100m_fp32.pt2"
            ]
        }
    ]
}
